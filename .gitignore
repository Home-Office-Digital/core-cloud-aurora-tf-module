# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Plan output files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
